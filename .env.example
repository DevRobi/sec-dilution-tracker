# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Database (local + cloud use Postgres) ---
# Local: docker compose up -d db  then use:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/buyback_tracker
# Render/Neon paste their connection string (postgres://... is auto-normalized).

# --- Market data APIs ---
POLYGON_API_KEY=your_polygon_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_string
# Token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Admin maintenance routes (POST /admin/cleanup) — header: X-Admin-Key
ADMIN_API_KEY=replace_with_a_long_random_string
# Auth rate limit: max attempts per IP per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
MIN_PASSWORD_LENGTH=8
MIN_USERNAME_LENGTH=3

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a real contact email.
SEC_USER_AGENT=DilutionTerminal/1.0 (you@domain.com)

# --- Dilution extraction (Claude by default) ---
# API web service: ENABLE_AI_EXTRACTION=false (cron fills dilution).
# Local AI cron / accuracy tests: ENABLE_AI_EXTRACTION=true
ENABLE_AI_EXTRACTION=true
# claude-code = Claude Code CLI on your logged-in Claude subscription (no API key; local only)
# anthropic   = Anthropic API via the official SDK (needs ANTHROPIC_API_KEY; use in Docker/Render)
# ollama      = local Ollama, explicit opt-in (model from OLLAMA_MODEL)
# Unset -> anthropic if ANTHROPIC_API_KEY is set, otherwise claude-code.
DILUTION_LLM_PROVIDER=claude-code
DILUTION_LLM_MODEL=claude-haiku-5-5
DILUTION_LLM_EFFORT=low
# ANTHROPIC_API_KEY=your_anthropic_key_here
# CLAUDE_CODE_BIN=/Users/you/.local/bin/claude
# DILUTION_LLM_TIMEOUT=180
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:8b
MAX_AI_CHUNKS_PER_FILING=8

# --- Preload universe + cron tuning ---
PRELOAD_TICKERS=AAPL,MSFT,NVDA
NON_AI_SYNC_DELAY_SECONDS=3
AI_DILUTION_DELAY_SECONDS=15
AI_DILUTION_MAX_FILINGS=12
SEED_TICKER_UNIVERSE=true
ALLOW_MANUAL_TICKER_SYNC=false

# --- Email alerts (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_specific_password
ALERT_FROM_EMAIL=you@gmail.com
